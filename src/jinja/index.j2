<!DOCTYPE html>
<html lang="en">
<head>
  <!--- META --->
  {% include 'meta.j2' %}
  <!--- FAVICON -->
  <link rel="shortcut icon" href="./src/images/logo.ico" type="image/x-icon">
  <!--- CSS --->
  <!--- THEMES (semantic colour tokens) --->
  <link rel="stylesheet" href="./src/css/themes/dark.css?v={{asset_version}}">
  <link rel="stylesheet" href="./src/css/themes/light.css?v={{asset_version}}">
  <link rel="stylesheet" href="./src/css/style.css?v={{asset_version}}">
  <!--- Resolve the theme before first paint to avoid a flash of the wrong one --->
  <script>
    (function () {
      var theme = "dark";
      try {
        var stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") {
          theme = stored;
        } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
          theme = "light";
        }
      } catch (e) { /* private mode: fall back to dark */ }
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <!--- GOOGLE FONT --->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <button class="theme-toggle" type="button" data-theme-toggle
          aria-label="Switch colour theme" title="Switch colour theme">
    <ion-icon name="sunny-outline" data-theme-icon></ion-icon>
  </button>
  <main>
    <!--- SIDEBAR-->
    {% include 'sidebar.j2' %}
    <div class="main-content">
      <!-- NAVBAR -->
      {% include 'navbar.j2' %}
      <!--- ABOUT -->
      {% include 'about.j2' %}
      <!-- EXPERIENCE -->
      {% include 'experience.j2' %}
      <!-- PROJECTS -->
      {% include 'projects.j2' %}
      <!-- CV -->
      {% include 'cv.j2' %}
      <!-- SKILLS -->
      {% include 'skills.j2' %}
    </div>
  </main>
  <!--- JS --->
  <script src="./src/js/script.js?v={{asset_version}}"></script>
  <!--- IONICONS --->
  <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>
